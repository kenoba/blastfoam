FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastEulerFoam;

startFrom       latestTime;

startTime       0;

beginTime       0;

stopAt          endTime;

endTime         0.0013;

writeControl    adjustableRunTime;

writeInterval   5e-05;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

deltaT          1e-09;

maxCo           0.2;

functions
{
    sampleLine
    {
        type            sets;
        libs            ( sampling );
        interpolationScheme cell;
        setFormat       raw;
        executeControl  writeTime;
        writeControl    writeTime;
        sets            ( line0 { type lineUniform ; axis distance ; start ( 0 1e-06 0 ) ; end ( 2 1e-06 0 ) ; nPoints 2000 ; } line45 { type lineUniform ; axis distance ; start ( 1e-06 1e-06 0 ) ; end ( 1.41421 1.41421 0 ) ; nPoints 2000 ; } line90 { type lineUniform ; axis distance ; start ( 1e-06 0 0 ) ; end ( 1e-06 2 0 ) ; nPoints 2000 ; } );
        fields          ( p T.gas U rho alpha.gas alpha.compBAl alpha.Al rho.gas rho.compBAl rho.Al U.gas U.compBAl U.Al );
    }
    pressureProbes
    {
        type            blastProbes;
        writeControl    timeStep;
        writeInterval   1;
        adjustLocations yes;
        probeLocations  ( ( 0.01 1e-06 0 ) ( 0.02 1e-06 0 ) ( 0.03 1e-06 0 ) ( 0.04 1e-06 0 ) ( 0.05 1e-06 0 ) ( 0.08 1e-06 0 ) ( 0.1 1e-06 0 ) ( 0.15 1e-06 0 ) ( 0.3 1e-06 0 ) ( 0.5 1e-06 0 ) ( 1 1e-06 0 ) ( 1.5 1e-06 0 ) ( 1.9 1e-06 0 ) ( 0.00707107 0.00707107 0 ) ( 0.0141421 0.0141421 0 ) ( 0.0212132 0.0212132 0 ) ( 0.0282843 0.0282843 0 ) ( 0.0353553 0.0353553 0 ) ( 0.0565685 0.0565685 0 ) ( 0.0707107 0.0707107 0 ) ( 0.106066 0.106066 0 ) ( 0.212132 0.212132 0 ) ( 0.353553 0.353553 0 ) ( 0.707107 0.707107 0 ) ( 1.06066 1.06066 0 ) ( 1.3435 1.3435 0 ) ( 1e-06 0.01 0 ) ( 1e-06 0.02 0 ) ( 1e-06 0.03 0 ) ( 1e-06 0.04 0 ) ( 1e-06 0.05 0 ) ( 1e-06 0.08 0 ) ( 1e-06 0.1 0 ) ( 1e-06 0.15 0 ) ( 1e-06 0.3 0 ) ( 1e-06 0.5 0 ) ( 1e-06 1 0 ) ( 1e-06 1.5 0 ) ( 1e-06 1.9 0 ) );
        fields          ( p alpha.compBAl alpha.gas alpha.Al );
    }
    angularProbes
    {
        type            blastProbes;
        writeControl    timeStep;
        writeInterval   1;
        adjustLocations yes;
        probeLocations  ( ( 0.3 1e-06 0 ) ( 0.289778 0.0776457 0 ) ( 0.259808 0.15 0 ) ( 0.212132 0.212132 0 ) ( 0.15 0.259808 0 ) ( 0.0776457 0.289778 0 ) ( 1e-06 0.3 0 ) ( 0.5 1e-06 0 ) ( 0.482963 0.12941 0 ) ( 0.433013 0.25 0 ) ( 0.353553 0.353553 0 ) ( 0.25 0.433013 0 ) ( 0.12941 0.482963 0 ) ( 1e-06 0.5 0 ) ( 1 1e-06 0 ) ( 0.965926 0.258819 0 ) ( 0.866025 0.5 0 ) ( 0.707107 0.707107 0 ) ( 0.5 0.866025 0 ) ( 0.258819 0.965926 0 ) ( 1e-06 1 0 ) ( 1.5 1e-06 0 ) ( 1.44889 0.388229 0 ) ( 1.29904 0.75 0 ) ( 1.06066 1.06066 0 ) ( 0.75 1.29904 0 ) ( 0.388229 1.44889 0 ) ( 1e-06 1.5 0 ) );
        fields          ( p );
    }
    radialPeakPressure
    {
        type            temporalMax;
        libs            ( "libblastFunctionObjects.so" );
        field           p;
        centre          ( 0 0 0 );
        writeControl    writeTime;
        outputRadial    true;
    }
}


